{
    "devnet": {
        "url": "https://devnetjobsindia.org/rfp_assignments.aspx",
        "search_input_selector": "input#ContentPlaceHolder1_txtKeywords",
        "search_button_selector": "input#ContentPlaceHolder1_imgSearchJob",
        "results_link_selector": "a[id*='lnkJobTitle']",
        "tender_title_selector": "#ContentPlaceHolder1_JD1_lblJobTitle",
        "tender_description_selector": "#ContentPlaceHolder1_JD1_tdDesc, #ContentPlaceHolder1_JD1_tdtxtDesc",
        "skip_date_filter": true
    },
    "ungm": {
        "url": "https://www.ungm.org",
        "requires_auth": true,
        "display_name": "UNGM (UN Global Marketplace)"
    },
    "afdb": {
        "search_url_template": "https://www.afdb.org/en/projects-and-operations/procurement?title={keyword}",
        "results_link_selector": ".views-field-title a",
        "tender_title_selector": "h1.page-header",
        "tender_description_selector": ".field-name-body",
        "skip_date_filter": false,
        "date_selector": ".date-display-single",
        "requires_stealth": true
    },
    "jobinrwanda": {
        "url": "https://www.jobinrwanda.com/jobs/tender",
        "search_input_selector": "input#edit-filter-titles-field",
        "search_button_selector": "button#edit-submit-jobs-display",
        "results_link_selector": "a[href*='/job/']",
        "tender_title_selector": ".field--name-title",
        "tender_description_selector": ".field--name-field-job-full-description",
        "skip_date_filter": true
    }
}