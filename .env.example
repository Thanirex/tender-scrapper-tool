# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── UNGM credentials (required for UNGM scraping) ─────────────────────────────
UNGM_EMAIL=your@email.com
UNGM_PASSWORD=yourpassword

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
# IMPORTANT: change this to a long random string in production
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# ── Superadmin seed (only used on first startup if no superadmin exists) ────────
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=admin@yourorg.com
SUPERADMIN_PASSWORD=Cnkonline@2026

# ── Data directory (Docker) ────────────────────────────────────────────────────
# Redirects all DB / downloads / logs to the mounted volume.
# Leave unset for local dev (defaults to ~/Documents/Tender Scrapping Documents).
TENDER_DATA_DIR=/data

# ── Database ───────────────────────────────────────────────────────────────────
# TAiQ connects to your company's existing MySQL server — no bundled DB is needed.
# Ask your IT / DBA team for the host, port, database name, username, and password,
# then fill in the line below and uncomment it.
#
# Format:
#   DATABASE_URL=mysql://<username>:<password>@<host>:<port>/<database>
#
# Example (replace every <...> with the values your IT team provides):
#   DATABASE_URL=mysql://taiq_user:s3cr3t@192.168.1.50:3306/taiq_db
#   DATABASE_URL=mysql://taiq_user:s3cr3t@mysql.internal:3306/taiq_db
#
# Notes:
#   • The database (taiq_db) must already exist on the MySQL server — ask IT to create it.
#   • The user must have full privileges on that database (CREATE, ALTER, INSERT, SELECT, UPDATE, DELETE).
#   • Port 3306 is the MySQL default; only change it if IT says otherwise.
#   • Leave unset to fall back to a local SQLite file (fine for testing, not for production).
#
# DATABASE_URL=mysql://<username>:<password>@<host>:3306/<database>
