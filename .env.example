# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── UNGM credentials (required for UNGM scraping) ─────────────────────────────
UNGM_EMAIL=your@email.com
UNGM_PASSWORD=yourpassword

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
# IMPORTANT: change this to a long random string in production
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# ── Superadmin seed (only used on first startup if no superadmin exists) ────────
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=admin@yourorg.com
SUPERADMIN_PASSWORD=Cnkonline@2026

# ── Data directory (Docker) ────────────────────────────────────────────────────
# Redirects all DB / downloads / logs to the mounted volume.
# Leave unset for local dev (defaults to ~/Documents/Tender Scrapping Documents).
TENDER_DATA_DIR=/data

# ── Database (optional — SQLite is the default) ────────────────────────────────
# Leave unset to use the default SQLite file inside TENDER_DATA_DIR.
#
# Custom SQLite path (e.g. a network share):
#   DATABASE_URL=sqlite:////mnt/company-share/taiq.db
#
# PostgreSQL on your company server:
#   DATABASE_URL=postgresql://taiq_user:password@db-server.company.com:5432/taiq_db
#   (also run schema.sql in that database first, and uncomment psycopg2-binary in requirements.txt)
#
# DATABASE_URL=
